@* one page for both views:
   "/"                 = homepage, one thumbnail per commander folder in Decklists
   "/commander/{Name}" = every card from that commander's decklists, using the dictionary built in Program.ReadDecklists *@
@page "/"
@page "/commander/{Name}"

<main>
    @if (Name == null)
    {
        <h1>Decklist Checker</h1>
        <p class="subtitle">Pick a commander to see how often each card shows up in its decklists.</p>

        <div class="commanders">
            @foreach (CommanderThumbnail Thumbnail in Thumbnails)
            {
                <a class="thumbnail" href="commander/@Uri.EscapeDataString(Thumbnail.Folder)">
                    <div class="thumbnail-cards">
                        @foreach (string Commander in Thumbnail.Commanders)
                        {
                            @CardPicture(Commander)
                        }
                    </div>
                    <span class="thumbnail-name">@Thumbnail.Folder</span>
                    <span class="thumbnail-count">@Thumbnail.FileCount decklists</span>
                </a>
            }
        </div>
    }
    else if (Result == null)
    {
        <a class="back" href="">&larr; All commanders</a>
        <h1>No decklists found for @Name</h1>
    }
    else
    {
        <a class="back" href="">&larr; All commanders</a>
        <h1>@FolderName</h1>
        <p class="subtitle">@Result.DataDict.Count different cards across @Result.FileCount decklists</p>

        <div class="cards">
            @foreach (KeyValuePair<string, int> DataPair in Result.DataDict)
            {
                <div class="card">
                    @CardPicture(DataPair.Key)
                    @* same percentage as the terminal version: decklists the card shows up in / total decklists *@
                    @{
                        float Percent = ((float)DataPair.Value / Result.FileCount) * 100;
                        string Rank = GetRank(DataPair.Value, Result.FileCount);
                    }
                    <span class="percent">
                        @(Percent.ToString("F2"))%
                        <span class="rank rank-@Rank.ToLower()">@Rank</span>
                    </span>
                </div>
            }
        </div>
    }
</main>

@code {
    //the folder name from the URL, or null on the homepage
    [Parameter] public string? Name { get; set; }

    private record CommanderThumbnail(string Folder, string[] Commanders, int FileCount);

    private List<CommanderThumbnail> Thumbnails = new();
    private DecklistResult? Result;
    private string FolderName = "";
    //card name -> Scryfall image link
    private Dictionary<string, string> CardImages = new();

    //runs on the server before the page is sent, so all the data (and Scryfall images) are ready when it renders
    protected override async Task OnParametersSetAsync()
    {
        if (Name == null)
        {
            //one thumbnail per folder in Decklists, showing that folder's most common commander(s)
            //NOTE: this reads (and looks up on Scryfall) every card in every folder so alternate-name commanders are merged too;
            //the first homepage load takes a few seconds, after that the Scryfall answers are cached
            Thumbnails = new();
            foreach (string Folder in Program.GetCommanderFolders())
            {
                DecklistResult Decks = await Program.ReadDecklists(Path.Combine(Program.DecklistsDirectory, Folder));
                Thumbnails.Add(new CommanderThumbnail(Folder, Decks.Commanders, Decks.FileCount));
                foreach (string Commander in Decks.Commanders)
                    if (Decks.CardImages.TryGetValue(Commander, out string? ImageUrl))
                        CardImages[Commander] = ImageUrl;
            }
        }
        else
        {
            //the same order-independent search as before, so "/commander/tymna kraum" also finds "Kraum Tymna"
            string? CommanderFolder = Program.FindCommanderFolder(Name);
            Result = CommanderFolder == null ? null : await Program.ReadDecklists(CommanderFolder);
            FolderName = Path.GetFileName(CommanderFolder) ?? Name;
            CardImages = Result?.CardImages ?? new();
        }
    }

    //letter rank for how often a card shows up:
    //100% = S, 80-99% = A, 60-79% = B, 40-59% = C, 20-39% = D, 0-19% = F
    //S compares the counts directly so it isn't affected by float rounding; the rest compare the percentage,
    //so e.g. 79.5% is still a B (it hasn't reached 80%)
    private static string GetRank(int Count, int FileCount)
    {
        if (Count >= FileCount) return "S";
        float Percent = (float)Count / FileCount * 100;
        if (Percent >= 80) return "A";
        if (Percent >= 60) return "B";
        if (Percent >= 40) return "C";
        if (Percent >= 20) return "D";
        return "F";
    }

    //shows the Scryfall image for a card, or its name in a card-shaped box if no image was found
    private RenderFragment CardPicture(string CardName) =>
        @<text>
            @if (CardImages.TryGetValue(CardName, out string? ImageUrl))
            {
                <img class="card-image" src="@ImageUrl" alt="@CardName" title="@CardName" loading="lazy" />
            }
            else
            {
                <div class="card-missing" title="@CardName">@CardName</div>
            }
        </text>;
}
